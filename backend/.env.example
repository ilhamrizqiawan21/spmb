APP_NAME="SPMB Terpadu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL 8.0.16+ (CHECK constraints are applied on MySQL/MariaDB only)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spmb
DB_USERNAME=spmb
DB_PASSWORD=spmb

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Redis is optional; switch CACHE_STORE/QUEUE_CONNECTION to `redis` when available.
CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Private document storage: `local` (storage/app/private) or an S3-compatible disk (`s3`).
SPMB_STORAGE_DISK=local
FILESYSTEM_DISK=local

# API token lifetime (Sanctum personal access tokens), in minutes.
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080

# Comma-separated list of allowed frontend origins (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173
