# Root-level variables consumed by docker-compose.yml and the frontend.
# The Laravel app reads its own configuration from backend/.env (see backend/.env.example).

# MySQL (docker-compose)
DB_DATABASE=spmb
DB_USERNAME=spmb
DB_PASSWORD=spmb
DB_ROOT_PASSWORD=root

# Frontend API client
VITE_API_BASE_URL=http://localhost:8000/api/v1
