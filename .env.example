# Application
APP_ENV=development
APP_NAME=SPMB Terpadu
APP_URL=http://localhost
API_V1_PREFIX=/api/v1

# Django (replace locally; never commit real values)
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-in-local-environment
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql+psycopg://spmb:spmb@localhost:5432/spmb
POSTGRES_DB=spmb
POSTGRES_USER=spmb
POSTGRES_PASSWORD=spmb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=spmb-documents
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
STORAGE_REGION=us-east-1

# Frontend API client
VITE_API_BASE_URL=http://localhost/api/v1

# Email / notification provider placeholders
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=noreply@example.test
